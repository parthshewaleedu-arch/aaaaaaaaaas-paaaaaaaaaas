# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/aaspaas_dev

# JWT Authentication
JWT_SECRET=your-secret-key-here-generate-with-openssl-rand-base64-32
JWT_REFRESH_SECRET=your-refresh-secret-key-here-generate-with-openssl-rand-base64-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Storage (S3 or Cloudinary)
STORAGE_TYPE=s3
STORAGE_BUCKET=aaspaas-images
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_REGION=ap-south-1
STORAGE_ENDPOINT_URL=https://s3.ap-south-1.amazonaws.com

# Google Maps
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@aaspaas.com
SMTP_PASSWORD=your-email-password
EMAIL_FROM=noreply@aaspaas.com
EMAIL_FROM_NAME=AAS PAAS

# Firebase (Push Notifications)
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-service-account.json

# Application Settings
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=True

# Base URL
API_BASE_URL=http://localhost:8000

# Frontend URLs
MOBILE_APP_URL=http://localhost:8080
ADMIN_PANEL_URL=http://localhost:3000
